{
  "schemaVersion": 1,
  "id": "moonotes_network",
  "version": "${version}",
  "name": "Moonotes Network",
  "description": "Optional Minecraft chat picker and emote completion, offline 7TV catalogs, per-server selection, Streamotes cache and Cloudflare fallback.",
  "authors": [
    "mymoon_x"
  ],
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.mymoonx.moonotesnetwork.MoonotesNetworkClient"
    ]
  },
  "mixins": [
    "moonotes-network.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "fabric-api": "*",
    "minecraft": "26.3",
    "java": ">=25",
    "streamotes": ">=1.2.16 <1.2.17"
  }
}
